{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticlebc.local/schemas/source.schema.json",
  "title": "Source registry",
  "description": "content/sources.json: every source any content may cite.",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "edition": { "type": "string", "description": "Edition, year or 'accessed' date." },
          "kind": { "enum": ["regulation", "tc-publication", "chs-publication", "textbook", "provider-page", "other"] },
          "reproduction": {
            "enum": ["permitted", "permitted-with-acknowledgement", "unclear", "not-permitted"],
            "description": "What we may do with its text. 'unclear' and 'not-permitted' mean paraphrase only, no quotes."
          },
          "read_directly": {
            "type": "boolean",
            "description": "False if the author only saw snippets or secondary summaries. Such sources need extra review."
          },
          "notes": { "type": "string" }
        },
        "required": ["id", "title", "publisher", "kind", "reproduction", "read_directly"],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": ["sources"],
  "additionalProperties": false
}
