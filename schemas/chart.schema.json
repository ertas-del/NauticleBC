{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nauticlebc.local/schemas/chart.schema.json",
  "title": "Synthetic training chart",
  "description": "One original, fictional training chart for the chartwork simulator, stored as data. The drawing, exercises and answer keys are all generated from these numbers. Never a copy or reconstruction of a CHS chart. Files: content/charts/<id>.chart.json.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/review" }],
  "$defs": {
    "position": {
      "type": "object",
      "description": "Decimal degrees. South latitudes and west longitudes are negative.",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["lat", "lon"],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "fictional": { "const": true, "description": "Always true. Every chart here is fictional." },
    "area_note": { "type": "string", "minLength": 20, "description": "Plain statement that the place is fictional and what it is for. Shown with the chart." },
    "module": { "$ref": "common.schema.json#/$defs/module" },
    "datum": {
      "type": "object",
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "depth_unit": { "enum": ["metres"] }
      },
      "required": ["description", "depth_unit"],
      "additionalProperties": false
    },
    "extent": {
      "type": "object",
      "properties": {
        "south": { "type": "number" },
        "west": { "type": "number" },
        "north": { "type": "number" },
        "east": { "type": "number" }
      },
      "required": ["south", "west", "north", "east"],
      "additionalProperties": false
    },
    "scale_ratio": { "type": "integer", "minimum": 1000, "description": "Nominal 1:n, shown in the title block." },
    "variation": {
      "type": "object",
      "properties": {
        "degrees": { "type": "integer", "minimum": 0, "maximum": 45 },
        "minutes": { "type": "integer", "minimum": 0, "maximum": 59 },
        "direction": { "enum": ["E", "W"] },
        "year": { "type": "integer" },
        "annual_change_minutes": { "type": "number", "description": "Minutes per year. Negative means decreasing." }
      },
      "required": ["degrees", "minutes", "direction", "year", "annual_change_minutes"],
      "additionalProperties": false
    },
    "compass_roses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "position": { "$ref": "#/$defs/position" } },
        "required": ["id", "position"],
        "additionalProperties": false
      }
    },
    "land": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["island", "mainland", "drying-flat"] },
          "ring": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/position" } }
        },
        "required": ["kind", "ring"],
        "additionalProperties": false
      }
    },
    "soundings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "position": { "$ref": "#/$defs/position" }, "depth_m": { "type": "number", "minimum": 0 } },
        "required": ["position", "depth_m"],
        "additionalProperties": false
      }
    },
    "contours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "depth_m": { "type": "number", "minimum": 0 },
          "line": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
        },
        "required": ["depth_m", "line"],
        "additionalProperties": false
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["rock", "drying-rock", "shoal", "wreck"] },
          "name": { "type": "string" },
          "position": { "$ref": "#/$defs/position" },
          "drying_height_m": { "type": "number", "minimum": 0, "description": "Height above chart datum, for drying rocks." },
          "depth_m": { "type": "number", "minimum": 0, "description": "Least depth over a submerged hazard." }
        },
        "required": ["id", "kind", "position"],
        "additionalProperties": false
      }
    },
    "aids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["light", "buoy", "beacon", "range-mark"] },
          "position": { "$ref": "#/$defs/position" },
          "characteristic": { "type": "string", "description": "For example Fl W 4s. Leave out for unlit aids." },
          "colour": { "type": "string" },
          "height_m": { "type": "number", "minimum": 0 },
          "range_nm": { "type": "number", "minimum": 0 },
          "notes": { "type": "string" }
        },
        "required": ["id", "name", "kind", "position"],
        "additionalProperties": false
      }
    },
    "legend": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": { "symbol": { "type": "string", "minLength": 1 }, "meaning": { "type": "string", "minLength": 1 } },
        "required": ["symbol", "meaning"],
        "additionalProperties": false
      },
      "description": "An original legend. Symbols are drawn from scratch, not copied from CHS artwork."
    },
    "source_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true,
      "description": "Optional. Sources for the conventions the chart follows, such as symbol or buoyage rules."
    }
  },
  "required": ["id", "title", "fictional", "area_note", "module", "datum", "extent", "scale_ratio", "variation", "compass_roses", "land", "soundings", "hazards", "aids", "legend", "review_status"],
  "unevaluatedProperties": false
}
