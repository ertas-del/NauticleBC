      "lesson_id": "machinery.piping.systems-and-precautions",
      "tickets": [
        "svmo"
      ],
      "difficulty": "medium",
      "stem": "Water hammer is:",
      "options": [
        "Air trapped in the tank",
        "Corrosion from sea water",
        "A leak at a flange",
        "A pressure shock caused by suddenly stopping or changing flow in a pipe"
      ],
      "correct_index": 3,
      "explanation": "Close valves slowly and avoid sudden flow changes to prevent damaged pipes.",
